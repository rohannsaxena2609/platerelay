{
  "uid": "platerelay-ops",
  "title": "PlateRelay Operations",
  "tags": ["platerelay", "backend", "operations"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "API request rate", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{uri!~\"/actuator/.*\"}[5m]))", "legendFormat": "{{method}} {{uri}}" }], "datasource": { "type": "prometheus", "uid": "prometheus" } },
    { "id": 2, "type": "timeseries", "title": "HTTP p95 latency", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator/.*\"}[5m])))", "legendFormat": "p95" }], "datasource": { "type": "prometheus", "uid": "prometheus" } },
    { "id": 3, "type": "timeseries", "title": "Donation and claim events recorded", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "sum by (event_type) (increase(platerelay_domain_events_recorded_total[15m]))", "legendFormat": "{{event_type}}" }], "datasource": { "type": "prometheus", "uid": "prometheus" } },
    { "id": 4, "type": "timeseries", "title": "Outbox publish failures", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }, "targets": [{ "expr": "increase(platerelay_outbox_publish_failures_total[15m])", "legendFormat": "failures" }], "datasource": { "type": "prometheus", "uid": "prometheus" } },
    { "id": 5, "type": "timeseries", "title": "Matching latency p95", "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(platerelay_matching_duration_seconds_bucket[5m])))", "legendFormat": "p95" }], "datasource": { "type": "prometheus", "uid": "prometheus" } },
    { "id": 6, "type": "timeseries", "title": "Impact ledger processing", "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 }, "targets": [{ "expr": "increase(platerelay_events_consumed_total[15m])", "legendFormat": "consumed" }, { "expr": "increase(platerelay_events_duplicate_total[15m])", "legendFormat": "duplicates" }], "datasource": { "type": "prometheus", "uid": "prometheus" } }
  ]
}
